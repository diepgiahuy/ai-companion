menu "Companion network"

config COMPANION_WIFI_SSID
    string "Development Wi-Fi SSID"
    default ""

config COMPANION_WIFI_PASSWORD
    string "Development Wi-Fi password"
    default ""

config COMPANION_TZ_RULE
    string "POSIX timezone rule for device clock"
    default "ICT-7"

config COMPANION_SERVER_URL
    string "Backend WebSocket URL (configure wss:// for product use)"
    default ""

config COMPANION_DEVICE_CREDENTIAL
    string "Enrolled per-device bearer credential"
    default ""

endmenu
