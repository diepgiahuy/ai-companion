FROM golang:1.25-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config libopus-dev python3 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Cache the Go dependency layer separately from source changes. The runtime gate
# still verifies the exact Go 1.25 toolchain before executing tests.
COPY backend/go.mod backend/go.sum ./backend/
RUN cd backend && go mod download

COPY . .
RUN go env GOVERSION | grep -Eq '^go1\.25([.]|$)'

CMD ["bash", "scripts/e2e.sh"]
