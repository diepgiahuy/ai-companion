COMPANION_ADDRESS=:8000
COMPANION_DATABASE=companion.db
COMPANION_DEVICE_TOKEN=change-me
COMPANION_TIMEZONE=Asia/Ho_Chi_Minh
COMPANION_RECORDINGS_DIR=data/recordings

# Agent runtime is explicit and fail-closed. `legacy` remains the production
# rollback/default until the ADK parity gate is green.
COMPANION_AGENT_RUNTIME=legacy

# Legacy compatibility path: OpenAI Chat Completions-compatible endpoint.
# Leave blank for deterministic mock fallback while COMPANION_AGENT_RUNTIME=legacy.
QWEN_BASE_URL=
# QWEN_BASE_URL=http://127.0.0.1:8081/v1
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3-4B-Instruct-2507

# CP-SW2 ADK experimental path. Build/run with the `adk` build tag. The current
# official ADK OpenAI adapter requires an endpoint implementing the OpenAI
# Responses API; a server exposing only /chat/completions is not sufficient.
ADK_OPENAI_BASE_URL=
ADK_OPENAI_API_KEY=
ADK_MODEL=Qwen/Qwen3-4B-Instruct-2507

# The hardware POC uses deterministic local stand-ins for ASR and TTS.
MOCK_TRANSCRIPT=hôm nay đi chợ 50k
