COMPANION_ADDRESS=:8000
# Required. companiond has no SQLite fallback and never runs migrations.
COMPANION_DATABASE_URL=postgres://companion_app:replace-with-runtime-password@127.0.0.1:5432/companion?sslmode=disable
COMPANION_POSTGRES_MAX_CONNS=8
COMPANION_POSTGRES_MIN_CONNS=0
COMPANION_POSTGRES_CONNECT_TIMEOUT=5s
COMPANION_POSTGRES_MAX_CONN_LIFETIME=30m
COMPANION_POSTGRES_MAX_CONN_IDLE_TIME=5m
COMPANION_POSTGRES_HEALTH_CHECK_PERIOD=30s
COMPANION_RIVER_RETENTION_INTERVAL=6h
COMPANION_RIVER_JOB_TIMEOUT=10m
COMPANION_RIVER_RESCUE_AFTER=20m
COMPANION_RIVER_SOFT_STOP_TIMEOUT=8s
COMPANION_RIVER_RUN_ON_START=true
# Non-production container networks only. Production rejects this override.
COMPANION_POSTGRES_ALLOW_INSECURE=false
COMPANION_TIMEZONE=Asia/Ho_Chi_Minh
COMPANION_RECORDINGS_DIR=data/recordings

# Device authentication is database-enrolled per-device only. Provision a
# credential through the admin credential endpoint; there is no shared device
# token environment variable or runtime selector.
COMPANION_ADMIN_TOKEN=replace-with-a-development-admin-token

# Runtime safety profile. Production rejects mock providers. Real ASR/TTS are
# still UNPROVEN/not wired in this checkpoint, so production currently fails
# closed instead of silently starting a fake voice stack.
COMPANION_PROFILE=development
COMPANION_ALLOW_MOCK_PROVIDERS=true

# ADK is the sole product agent runtime. Build/run companiond with the `adk`
# tag. The OpenAI-compatible ADK adapter requires a Responses API endpoint.
# Startup fails closed when ADK_OPENAI_BASE_URL or ADK_MODEL is missing.
ADK_OPENAI_BASE_URL=http://127.0.0.1:8081/v1
ADK_OPENAI_API_KEY=
ADK_MODEL=Qwen/Qwen3-4B-Instruct-2507
COMPANION_LLM_HTTP_TIMEOUT=45s

# Versioned/composable prompt bundle. Leave COMPANION_PROMPT_DIR empty to use
# the embedded companion/v4 bundle.
COMPANION_PROMPT_DIR=
COMPANION_PERSONA=

# Long-term memory embedding provider. Leave empty to use the deterministic
# local hash embedding used by the current POC path; a configured endpoint is
# used by memory only and does not select the agent runtime.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding

# Deterministic test/development stand-ins. These never count as production
# evidence and cannot be enabled under COMPANION_PROFILE=production.
MOCK_TRANSCRIPT=hôm nay đi chợ 50k
