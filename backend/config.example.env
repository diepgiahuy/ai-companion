COMPANION_ADDRESS=:8000
COMPANION_DATABASE=companion.db
COMPANION_DEVICE_TOKEN=change-me
COMPANION_TIMEZONE=Asia/Ho_Chi_Minh
COMPANION_RECORDINGS_DIR=data/recordings

# Runtime safety profile. Production rejects mock providers. Real ASR/TTS are
# still UNPROVEN/not wired in this checkpoint, so production currently fails
# closed instead of silently starting a fake voice stack.
COMPANION_PROFILE=development
COMPANION_ALLOW_MOCK_PROVIDERS=true

# Agent runtime is explicit. `legacy` remains the rollback/default until ADK
# durable-session/full-tool parity is proven.
COMPANION_AGENT_RUNTIME=legacy

# LLM generation policy: validated at startup instead of hard-coded in qwen.go.
COMPANION_LLM_HTTP_TIMEOUT=45s
COMPANION_LLM_TEMPERATURE=0.1
COMPANION_LLM_MAX_TOKENS=384
COMPANION_LLM_MAX_TOOL_ROUNDS=3

# Versioned/composable prompt bundle. Leave COMPANION_PROMPT_DIR empty to use
# the embedded companion/v4 bundle. Point it at an external compatible bundle
# to change policy/persona without recompiling the Go binary.
COMPANION_PROMPT_DIR=
COMPANION_PERSONA=

# Model routing. `static` does not inspect text. `semantic` requires a real
# embedding endpoint, QWEN_REASONING_MODEL, and a JSON prototype file containing
# {"fast":[...],"reasoning":[...],"margin":0.05}.
COMPANION_MODEL_ROUTER=static
COMPANION_MODEL_ROUTER_EXAMPLES=

# Legacy compatibility path: OpenAI Chat Completions-compatible endpoint.
# In development/test, leaving this blank is allowed only while mock providers
# are enabled. Production fails closed.
QWEN_BASE_URL=
# QWEN_BASE_URL=http://127.0.0.1:8081/v1
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3-4B-Instruct-2507
QWEN_FAST_MODEL=Qwen/Qwen3-4B-Instruct-2507
QWEN_REASONING_MODEL=

# Semantic router / long-term memory embedding provider.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding

# ADK path. Build/run with the `adk` tag. The current official ADK OpenAI
# adapter requires an OpenAI Responses API-compatible endpoint.
ADK_OPENAI_BASE_URL=
ADK_OPENAI_API_KEY=
ADK_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Deterministic test/development stand-ins. These never count as production
# evidence and cannot be enabled under COMPANION_PROFILE=production.
MOCK_TRANSCRIPT=hôm nay đi chợ 50k
