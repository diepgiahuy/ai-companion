# ── Required ──────────────────────────────────────────────
# OpenAI-compatible API endpoint used by the ADK agent runtime.
# Examples:
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI:  https://api.openai.com/v1
ADK_OPENAI_BASE_URL=

# Model identifier for the ADK agent runtime.
# Examples: gemini-2.5-flash, gpt-4o-mini
ADK_MODEL=

# API key for the ADK provider above.
ADK_OPENAI_API_KEY=

# ── Development speech ────────────────────────────────────
# Use Gemini Live only for development and hardware testing before production selection.
# Set COMPANION_PROFILE=development and COMPANION_SPEECH_PROFILE=gemini-live-dev.
# The production profile rejects gemini-live-dev.
# Use test accounts and non-sensitive test data with Free Tier.
# COMPANION_PROFILE=development
# COMPANION_SPEECH_PROFILE=gemini-live-dev
# GEMINI_TOKEN=
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_LIVE_VOICE=Kore
# GEMINI_LIVE_URL=

# ── Optional ──────────────────────────────────────────────
# Protocol for the ADK model (leave blank for default).
# ADK_MODEL_PROTOCOL=

# Timezone for the companion (default: Asia/Ho_Chi_Minh).
# COMPANION_TIMEZONE=Asia/Ho_Chi_Minh

# Embedding provider for semantic memory (optional).
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=

# Market data API keys (optional — enables gold/stock/crypto tools).
# COINGECKO_API_KEY=
# TWELVEDATA_API_KEY=
# ALPHAVANTAGE_API_KEY=
# PNJ_GOLD_ENABLED=false

# OTA firmware signing (optional — production only).
# OTA_PUBLIC_KEY=
# OTA_REQUIRE_SIGNATURE=false

# Admin bearer token for management endpoints (optional).
# COMPANION_ADMIN_TOKEN=
