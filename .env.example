# ── Required ──────────────────────────────────────────────
# OpenAI-compatible API endpoint used by the ADK agent runtime.
# Examples:
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI:  https://api.openai.com/v1
ADK_OPENAI_BASE_URL=

# Model identifier for the ADK agent runtime.
# Examples: gemini-2.5-flash, gpt-4o-mini
ADK_MODEL=

# API key for the ADK provider above.
ADK_OPENAI_API_KEY=

# ── Development agent candidate ───────────────────────────
# Use this #23 candidate only for development and HIL with non-sensitive test data.
# Production-v1 model selection remains open until a privacy-safe production runtime has comparable evidence.
# ADK_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ADK_MODEL=gemma-4-31b-it
# ADK_MODEL_PROTOCOL=chat_completions
# ADK_OPENAI_API_KEY=

# ── Development speech ────────────────────────────────────
# Use Gemini Live only for development and hardware testing before production selection.
# Set COMPANION_PROFILE=development and COMPANION_SPEECH_PROFILE=gemini-live-dev.
# The production profile rejects gemini-live-dev.
# Use test accounts and non-sensitive test data with Free Tier.
# COMPANION_PROFILE=development
# COMPANION_SPEECH_PROFILE=gemini-live-dev
# GEMINI_TOKEN=
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_LIVE_VOICE=Kore
# GEMINI_LIVE_URL=

# ── Optional ──────────────────────────────────────────────
# Protocol for the ADK model. Leave blank to use the default.
# ADK_MODEL_PROTOCOL=

# Timezone for the companion. The default is Asia/Ho_Chi_Minh.
# COMPANION_TIMEZONE=Asia/Ho_Chi_Minh

# Embedding provider for semantic memory. This provider is optional.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=

# Market data API keys enable optional gold, stock, and crypto tools.
# COINGECKO_API_KEY=
# TWELVEDATA_API_KEY=
# ALPHAVANTAGE_API_KEY=
# PNJ_GOLD_ENABLED=false

# OTA firmware signing is optional outside production.
# OTA_PUBLIC_KEY=
# OTA_REQUIRE_SIGNATURE=false

# Admin bearer token for management endpoints. This token is optional.
# COMPANION_ADMIN_TOKEN=
